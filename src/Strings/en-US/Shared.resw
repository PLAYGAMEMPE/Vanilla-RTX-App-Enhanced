    <value>A message from the developer:</value>
  </data>
  <data name="ReviewPrompt_MessageBody1" xml:space="preserve">
    <value>&#x0a;&#x0a;If you've enjoyed the app or have found it helpful so far, &#x0a;you can sponsor me through my</value>
