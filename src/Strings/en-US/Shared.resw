  </data>
  <data name="ReviewPrompt_MessageBody3" xml:space="preserve">
    <value>&#x0a;All of which I've released and upkept for years free of charge, ads,</value>
  </data>
  <data name="ReviewPrompt_MessageBody4" xml:space="preserve">
    <value>&#x0a;microtransactions, or other nonsense that ruins a good user experience.</value>
  </data>
  <data name="ReviewPrompt_MessageBody5" xml:space="preserve">
