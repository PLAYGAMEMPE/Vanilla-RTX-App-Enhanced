<?xml version="1.0" encoding="utf-8"?>
<!--
  IMPORTANT: this file must NOT be named "win-$(Platform).pubxml" (e.g.
  "win-x64.pubxml") - the .csproj's own <PublishProfile>win-$(Platform).pubxml
  </PublishProfile> property makes the MSIX packaging SDK auto-import
  WHATEVER pubxml matches that exact name into every build, not just
  publishes - including plain packaged `dotnet build` (dev-mode). That
  actually happened once: creating a "win-x64.pubxml" here to silence a
  harmless "profile not found" warning made WindowsPackageType=None leak into
  modo-desarrollo.bat's packaged MSIX build, breaking it with "WindowsPackageType
  is set to None, but GenerateAppxPackageOnBuild is set to true". Keeping this
  file under a name the .csproj doesn't reference by default, and always
  passing -p:PublishProfile=Portable-x64 explicitly (never relying on any
  default resolution), keeps it fully isolated from dev-mode.

  Publishes a single, self-contained, unpackaged "Vanilla RTX App.exe" - no
  installer, no MSIX, no certificate trust dance, no companion files or folders.
  Copy that one .exe anywhere (verified: it runs correctly from a folder with
  nothing else in it) and double-click it.

    dotnet publish "Vanilla RTX App.csproj" -c Release -p:Platform=x64 -p:PublishProfile=Portable-x64
    (or just run scripts\publish-portable.ps1 / compilar-portable.bat, which also
    discard the empty leftover folders MSBuild's bundler leaves behind and copy
    just the .exe into a clean "Portable\" folder)

  WindowsPackageType=None takes this out of MSIX packaging entirely (see
  https://learn.microsoft.com/windows/apps/windows-app-sdk/unpackaged-deployment).
  SelfContained + WindowsAppSDKSelfContained bundle both the .NET runtime and the
  Windows App SDK runtime into the output - but NOT the Visual C++ Redistributable.

  That gap is real, not theoretical: Windows App SDK's native (C++) components -
  Microsoft.WindowsAppRuntime.dll, DWriteCore.dll, and friends - dynamically link
  against vcruntime140.dll / vcruntime140_1.dll / msvcp140.dll and the rest of the
  VC++ 2015-2022 runtime, same as any classic native Win32 app. .NET's own
  self-contained bundling only covers the managed CLR side (that part genuinely
  needs nothing preinstalled, by design since .NET Core 3.0) - it has no reason to
  know about a completely separate native dependency pulled in by another SDK, so it
  doesn't bundle it. A dev machine almost always has these DLLs in System32 already
  (Visual Studio, games, countless other installers put them there), which is
  exactly why a build can run perfectly on the machine that produced it and then
  fail silently - no window, no error - on a clean machine that never had a reason
  to install the VC++ Redistributable. The ItemGroup below bundles verified,
  Microsoft-signed copies of those DLLs (see src\Runtimes\win-x64\vcredist\) so the
  published .exe carries its own copy instead of gambling on the target machine
  already having them, which is the whole point of calling this build "portable".

  PublishSingleFile + IncludeNativeLibrariesForSelfExtract +
  IncludeAllContentForSelfExtract fold everything else - native WinAppSDK/Magick.NET/
  ONNX Runtime libraries AND all of the app's own Content assets (Assets\, Modules\
  images, fonts, GIFs) - into that same .exe too, rather than leaving them as loose
  files alongside it (confirmed empirically: publishing without these three additional
  properties still leaves ~300 asset files and ~50 native DLLs sitting in the output
  folder even though SelfContained+WindowsAppSDKSelfContained alone already make the
  app runnable without pre-installed dependencies - single-file bundling is a
  separate, additional step on top of that).

  Under the hood, a self-contained single-file .NET app always self-extracts its
  bundled native components to a per-app cache under %TEMP%\.net\ on first run on
  each machine (standard .NET behavior, not specific to this project) - reused on
  every later launch without re-extracting. This is invisible to whoever runs it;
  the distributed artifact is still genuinely just the one .exe.

  This profile only affects `dotnet publish` - the everyday dev-mode build/run flow
  (modo-desarrollo.bat) is untouched and keeps using the MSIX-packaged debug build it
  was already validated against.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- A stable PRI name keeps ms-appx resources resolvable when a browser, chat app,
         or user renames the downloaded executable. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\x64\Publish\</PublishDir>
  </PropertyGroup>

  <!-- Verified, Microsoft-signed VC++ 2015-2022 Redistributable (x64) DLLs - see the
       big comment above for why the portable build needs its own copy of these.
       CopyToOutputDirectory + IncludeAllContentForSelfExtract (set above) is enough
       to get them bundled into the single .exe and genuinely extracted at runtime -
       confirmed by launching the built .exe and inspecting its %TEMP% self-extraction
       folder. They land under Runtimes\win-x64\vcredist\ inside that extraction
       folder (every attempt at making the single-file bundler flatten that path to
       the extraction root instead got silently overridden - tried three different
       MSBuild metadata techniques, none stuck). Rather than keep fighting that,
       Core\NativeDependencyBootstrap.cs preloads the signed libraries from this exact
       nested path before WinAppSDK resolves its native dependencies, without changing
       WinUI's process-wide DLL search policy. Keep both paths in sync if this moves. -->
  <ItemGroup>
    <!-- Paths in a .pubxml resolve relative to THIS file's own folder
         (Properties\PublishProfiles\), not the project root - hence ..\..\ -->
    <None Include="..\..\Runtimes\win-x64\vcredist\*.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
