<Window x:Class="Vanilla_RTX_App.Modules.BetterRTXManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Vanilla_RTX_App.Modules"
        x:Uid="Window"
        Title="BetterRTX Manager">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Border x:Name="LightThemeOverlay"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="False"
                Visibility="{ThemeResource LightThemeBackgroundVisibility}"
                Canvas.ZIndex="-1">
            <Border.Background>
                <SolidColorBrush Color="#17373737" />
            </Border.Background>
        </Border>

        <!-- Loading Screen -->
        <Grid x:Name="LoadingPanel"
              Visibility="Visible"
              Background="Transparent">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="20">
                <ProgressRing IsActive="True"
                              Width="100"
                              Height="100" />

                <Button x:Name="ManualSelectionButton"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        Padding="20,12,20,12"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ManualSelectionButton_Click">
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ManualSelectionIntroText"
                                   x:Uid="ManualSelectionIntroText"
                                   FontSize="15"
                                   TextAlignment="Center"
                                   FontWeight="Medium"
                                   HorizontalAlignment="Center"
                                   IsTextScaleFactorEnabled="False" />
                        <TextBlock x:Name="ManualSelectionText"
                                   x:Uid="ManualSelectionText"
                                   FontSize="13"
                                   Opacity="0.8"
                                   FontWeight="Medium"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"
                                   IsTextScaleFactorEnabled="False" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Preset Selection UI -->
        <Grid x:Name="PresetSelectionPanel"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title Bar Area -->
            <Grid Grid.Row="0"
                  x:Name="TitleBarArea"
                  Background="Transparent">
                <!-- Centered Title -->
                <Grid HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <TextBlock Text=""
                               Margin="0,2,0,0"
                               VerticalAlignment="Center"
                               IsTextScaleFactorEnabled="False"
                               IsHitTestVisible="False"
                               x:Name="WindowTitle" />
                </Grid>
            </Grid>

            <!-- Preset List -->
            <Grid Grid.Row="1">
                <!-- Shadow receiver sits behind the scroll content -->
                <Grid x:Name="ShadowReceiverGrid" />

                <ScrollViewer Padding="20,16,24,0"
                              Margin="0,-4,0,0"
                              IsTextScaleFactorEnabled="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <!-- Wrapped both panels in a single parent StackPanel -->
                    <StackPanel>
                        <!-- PSA cards (Horizontal margins removed to avoid duplicating ScrollViewer padding) -->
                        <StackPanel x:Name="BetterRTXAnnouncementsPanel"
                                    Spacing="10"
                                    Margin="0,12,0,14" />
                        <!-- Preset list -->
                        <StackPanel x:Name="PresetListContainer"
                                    Spacing="12"
                                    Padding="0,0,0,12"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel"
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed"
                        Spacing="12">
                <FontIcon Glyph="&#xEABC;"
                          FontSize="50"
                          IsTextScaleFactorEnabled="False"
                          Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyStateText"
                           x:Uid="EmptyStateText"
                           FontSize="14"
                           IsTextScaleFactorEnabled="False"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>

        <!-- Refresh Button -->
        <Button x:Name="RefreshButton"
                Width="52"
                Height="36"
                Margin="32,1,0,0"
                Padding="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="0, 0, 6, 6"
                Click="RefreshButton_Click"
                Translation="0,0,16"
                IsTextScaleFactorEnabled="False">
            <Button.Shadow>
                <ThemeShadow />
            </Button.Shadow>
            <Grid>
                <FontIcon x:Name="RefreshIcon"
                          Glyph="&#xE72C;"
                          FontSize="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Margin="0, -3, 0, 0"
                          IsTextScaleFactorEnabled="False" />
                <TextBlock x:Name="RefreshCountdownText"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0, -3, 0, 0"
                           Visibility="Collapsed"
                           IsTextScaleFactorEnabled="False" />
            </Grid>
        </Button>
    </Grid>
</Window>
